# Backend server
PORT=3000
LOG_LEVEL=info
# Set true to hide noisy polling access logs such as GET /api/pdfs from console.
SUPPRESS_POLLING_REQUEST_LOGS=false
# Comma-separated URL path prefixes to suppress when SUPPRESS_POLLING_REQUEST_LOGS=true.
POLLING_REQUEST_LOG_PATHS=/api/pdfs

# Storage paths
STORAGE_ROOT=./storage
DB_PATH=./data/app.db

# Upload limits
MAX_UPLOAD_MB=50

# Pipeline / worker (M2)
PROCESS_CONCURRENCY=2
RENDER_DPI=150
# Leave empty to use pdftoppm / pdfinfo from PATH.
# Otherwise set to the directory that contains the poppler binaries
# (e.g. /opt/homebrew/bin on Apple Silicon).
POPPLER_BIN_PATH=

# 單元測試要向哪一個帳號借 LLM/TTS 設定（accounts/<id>/settings.env）。留空＝需要真的
# 呼叫 LLM/TTS 的測試自動略過（CI 或沒填 key 的機器照常綠燈）。
# 設定方式與範例見 docs/test-ai-account.md；範本在 accounts.example/test/settings.env。
TEST_AI_ACCOUNT_ID=

# OpenAI (M3): LLM for per-page script + title generation.
# 👉 Do NOT commit a real API key. Copy this file to .env and fill locally.
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
# Deprecated and no longer read: the script language is the account's 「輸出語言」 setting
# (CONTENT_LANGUAGE / 設定 → AI 設定). This one used to be stated in the per-page prompt, where it
# silently overrode that setting.
# OPENAI_SCRIPT_LANGUAGE=zh-TW
# Target per-page script length (allow ±20%). 150 ≈ 60 seconds of Mandarin speech.
OPENAI_SCRIPT_TARGET_CHARS=150
# Prompt style hint only (not enforced).
OPENAI_SCRIPT_STYLE=natural_spoken
# 把每頁投影片的 PNG 圖像也送給 LLM（需使用 vision 模型，如 gpt-4o-mini）。
OPENAI_SCRIPT_USE_IMAGES=true
# 送給 LLM 前先縮圖到這個寬度 (px)，避免 token 爆炸。
OPENAI_SCRIPT_IMAGE_MAX_WIDTH=1024
# 夾帶「上一頁腳本」作為銜接參考的最大字元數；過長會被截斷。
OPENAI_SCRIPT_PREV_CONTEXT_CHARS=400
# 夾帶「下一頁原文」作為銜接預告的最大字元數；過長會被截斷。
OPENAI_SCRIPT_NEXT_CONTEXT_CHARS=600
# OpenAI client knobs.
OPENAI_REQUEST_TIMEOUT_MS=240000
OPENAI_MAX_RETRIES=3
# Cost guardrail — refuse PDFs over this many pages before calling the LLM.
OPENAI_MAX_PAGES=50
# Weekly USD spending cap (LLM+TTS combined) per account when that account has no API key of its
# own configured and is therefore using this shared default key. Resets every Thursday. Accounts
# with their own key are never gated by this.
DEFAULT_SOURCE_WEEKLY_QUOTA_USD=1
OPENAI_IMAGE_MODEL=gpt-image-2
# Image quality: low / medium / high / auto
OPENAI_IMAGE_QUALITY=low
# Base timeout for image generation requests (ms)
OPENAI_IMAGE_TIMEOUT_MS=60000
# Timeout when quality is medium/high (ms)
OPENAI_IMAGE_TIMEOUT_MS_HIGH_QUALITY=120000

# OpenAI TTS (M4): per-page audio synthesis.
# Model: gpt-4o-mini-tts (default), tts-1, tts-1-hd
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Voice: alloy (default), ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse
OPENAI_TTS_VOICE=alloy
# Audio format (currently only mp3 is supported).
OPENAI_TTS_FORMAT=mp3
# Playback speed multiplier (0.25–4.0). 1.0 is natural.
OPENAI_TTS_SPEED=1.0
# How many TTS calls to run in parallel per PDF.
TTS_CONCURRENCY=2

# audio.cpp — local TTS (https://github.com/0xShug0/audio.cpp). Select it with
# TTS_PROVIDER=audiocpp. It needs no API key and makes no network calls: everything below is
# about where the engine lives on this machine and which hardware it runs on. You have to
# install audio.cpp and download a model yourself.
#
# How the backend reaches it:
#   cli    — spawn audiocpp_cli once per segment. THIS is the mode where the CPU/GPU choice
#            below applies, because the backend is a command-line flag.
#   server — POST to a running audiocpp_server's OpenAI-compatible /v1/audio/speech. The model
#            stays resident (much faster per page), but that server's own server.json decides
#            whether it runs on the CPU or the GPU.
#   auto   — server when AUDIOCPP_TTS_BASE_URL is set, cli otherwise.
AUDIOCPP_TTS_MODE=auto
# Only for server mode, e.g. http://127.0.0.1:8080/v1
AUDIOCPP_TTS_BASE_URL=
# audiocpp_cli, or an absolute path to it. Leave it EMPTY to let start.sh fill it in after it
# builds the engine for you (it only overwrites an empty value, never one you set yourself).
AUDIOCPP_TTS_BIN=
# start.sh checks for the engine whenever TTS_PROVIDER/SECONDARY_TTS_PROVIDER is audiocpp (or you
# pass --install-audiocpp) and builds it if missing — clone + compile, roughly ten minutes, into
# .audiocpp/ with the log in audiocpp-build.log. Set false to check-and-warn only.
# A GPU build that fails (usually a missing toolkit) is retried on the CPU. Models are never
# downloaded automatically: each family is several GB and only you can pick the right one.
AUDIOCPP_AUTO_INSTALL=true
# cli mode: passed straight to `audiocpp_cli --model`. Most families take the model DIRECTORY
# (e.g. .../models/Qwen3-TTS-12Hz-1.7B-Base-GGUF), a few take the .gguf FILE itself
# (confucius4_tts, dramabox) — see docs/audiocpp-local-tts.md §2. Use an absolute path.
# server mode: the model id from server.json.
AUDIOCPP_TTS_MODEL=
# Model family for the CLI, e.g. qwen3_tts, voxcpm2, pocket_tts.
# NOTE pocket_tts has no Chinese (en/de/it/pt/es); for zh-TW decks pick qwen3_tts/voxcpm2/index_tts2.
AUDIOCPP_TTS_FAMILY=
# Compute backend (cli mode): auto | cpu | cuda | vulkan | metal | hip.
# auto = Metal on macOS, CUDA with an NVIDIA driver, HIP with an AMD one, otherwise CPU.
# A GPU backend that turns out to be unusable (no driver, CPU-only build) falls back to the CPU
# for that segment instead of failing the page.
AUDIOCPP_TTS_BACKEND=auto
# GPU ordinal on multi-GPU hosts; blank lets audio.cpp choose.
AUDIOCPP_TTS_DEVICE=
# CPU threads; blank uses audio.cpp's own default.
AUDIOCPP_TTS_THREADS=
# Extra `--load-option key=value` pairs, comma-separated (e.g. language=chinese).
AUDIOCPP_TTS_LOAD_OPTIONS=
# Which CLI flag a built-in voice name rides on. 'auto' picks by family: Qwen3-TTS reads
# --speaker (Vivian, Ryan, …), everything else --voice-id. A path always goes to --voice-ref.
# Sending the wrong one fails every segment, so this exists to be forced without a code change.
AUDIOCPP_TTS_VOICE_FLAG=auto
# Text language. Blank derives it from the deck's content language for qwen3_tts, whose vocabulary
# we know (zh-TW/zh -> chinese, en -> english); other families are sent nothing, because the words
# differ per family and a wrong one is a CLI error on every segment. Anything you put here is
# passed to `--language` verbatim — including `Auto` to let the model infer it, which is what it
# did before this existed: a zh-TW deck could come back read in Cantonese.
AUDIOCPP_TTS_LANGUAGE=
# Rewrite Chinese into Simplified characters before handing the text to the model. This is a
# pronunciation cue, not a translation: subtitles, transcripts and everything stored keep the
# deck's own text. 'auto' applies it only where it was observed to matter — Qwen3 VoiceDesign
# reads Traditional as Cantonese (same sentence, same instruction, same seed: Traditional gives
# Cantonese, Simplified gives Mandarin, and asking for Mandarin in the instruction does not help).
# CustomVoice and cloning are unaffected. 'on'/'off' force it either way.
AUDIOCPP_TTS_SIMPLIFY_CHINESE=auto
# Sampling seed. Empty = audio.cpp's own randomness, which means the same page re-narrated comes
# back slightly different every time. Set any value and a given text reproduces byte for byte.
# Note this fixes a *segment*, not a voice: VoiceDesign still redesigns the voice per segment, so
# for one consistent voice across a deck, freeze it into a reference clip (settings page button).
AUDIOCPP_TTS_SEED=
# Whether to prepend the language/persona steering block the Gemini paths use. Off by default:
# most audio.cpp families are acoustic models with no instruction following, so the steering
# line would simply be read aloud before the script. Not needed for qwen3_tts — its persona goes
# to the model's own --instruct field, which is never spoken (see docs/audiocpp-local-tts.md).
AUDIOCPP_TTS_PROMPT_STEERING=false
# Per-segment ceiling (ms). Generous because a CPU-only run is local compute, not a round trip.
AUDIOCPP_TTS_TIMEOUT_MS=600000
# Per-speaker persona and voice. A voice is the family's built-in voice id (e.g. alba); a path
# to a .wav is used as a reference clip for voice cloning. Blank = the family's default voice.
# For qwen3_tts the voice also picks the model package, since the three are separate downloads
# that sit side by side (only one path goes in AUDIOCPP_TTS_MODEL; the others are derived):
#   speaker id       -> …-CustomVoice-GGUF, --task tts,  --speaker
#   path to a .wav   -> …-Base-GGUF,        --task tts,  --voice-ref + --reference-text
#                       (cloning needs the clip's transcript in <clip>.wav.txt beside it)
#   ' voice-design'  -> …-VoiceDesign-GGUF, --task vdes, the persona above *is* the voice
# The settings page writes these; see docs/audiocpp-local-tts.md §2 before setting them by hand.
AUDIOCPP_TTS_SPEAKER1=
AUDIOCPP_TTS_SPEAKER2=
AUDIOCPP_TTS_SPEAKER1_VOICE=
AUDIOCPP_TTS_SPEAKER2_VOICE=

# Google OAuth login.
# GOOGLE_CLIENT_ID must be the OAuth Web Client ID ending with .apps.googleusercontent.com,
# not the Google Cloud project number.
# GOOGLE_CLIENT_SECRET is the OAuth client secret from the same Web application client.
# Redirect URI defaults to /api/auth/google/callback on the current host; if set,
# use an absolute URL or a path beginning with /.
# Set GOOGLE_AUTH_ENABLED=false to disable Google login even when credentials
# are present in process environment variables.
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
AUTH_SESSION_SECRET=change-me-to-a-long-random-string

# Jupyter notebook slide pages (in-browser cell execution).
# Set JUPYTER_ENABLED=true and JUPYTER_PROXY_TARGET to a loopback Jupyter server
# (jupyter_server >= 2) for the backend to reverse-proxy; start.sh launches one for you.
JUPYTER_ENABLED=false
JUPYTER_PROXY_TARGET=https://127.0.0.1:8899
# Which Anaconda/Conda environment the notebook kernels run in. Point this at a conda
# environment PREFIX (the directory that contains bin/jupyter), e.g. /opt/Anaconda3 or
# /opt/Anaconda3/envs/ds or ~/miniconda3/envs/myenv. That environment must have
# jupyter_server >= 2 and ipykernel installed (conda install -y "jupyter_server>=2" ipykernel).
# When set, start.sh runs Jupyter from it so cells see that env's packages (numpy, pandas, …).
# Leave blank to use the bundled .jupyter-venv / system jupyter instead.
JUPYTER_CONDA_PREFIX=
# On startup, auto-scan Conda/Anaconda environments (the base + its envs/*) and register each one
# that has ipykernel as a Jupyter kernel, so the in-app "Environment" dropdown lists them without
# installing nb_conda_kernels. Set to false to disable the scan.
JUPYTER_SCAN_CONDA_ENVS=true

# Multi-user Jupyter notebooks via Kubeflow (docs/jupyter-kubeflow-deployment.md). Only relevant
# when deployed inside a Kubeflow cluster; JUPYTER_ENABLED above must also be true. Ignored by the
# proxy/url modes configured above (those remain single-user/desktop only — see the deployment
# guide's warning before using them for any multi-user deployment).
JUPYTER_MODE=proxy
# Template for deriving a Kubeflow profile namespace from the account's MakeSlide session email;
# {user} is replaced with the email's local-part (the part before @).
KUBEFLOW_DEFAULT_NAMESPACE_TEMPLATE={user}
# Notebook CR name prefix used for runtime discovery (GET /api/jupyter/runtimes); the suffix after
# this prefix is the runtime type shown in the notebook toolbar (e.g. makeslide-jupyter-gpu-a100 -> gpu-a100).
KUBEFLOW_NOTEBOOK_PREFIX=makeslide-jupyter-
# Image used when auto-creating the zero-config makeslide-jupyter-cpu default notebook for a user
# with no makeslide-jupyter-* notebook yet. See the deployment guide's image-selection guidance
# before setting this in production. Leave blank to rely on the cluster/admission-webhook default.
KUBEFLOW_DEFAULT_RUNTIME_IMAGE=
# requests/limits for that auto-created CPU default notebook, as comma-separated key=value pairs.
KUBEFLOW_DEFAULT_RUNTIME_RESOURCES=cpu=1,memory=2Gi

# ──────────────────────────────────────────────────────────────────────────────
# start.sh 的啟動設定
#
# 每一台安裝共用同一份 start.sh；「這台機器不一樣」的地方全部寫在這裡，不要去改那個腳本
# ——改了就跟不上 git，下次 pull 還會衝突。命令列參數一律優先於這裡的值。
# ──────────────────────────────────────────────────────────────────────────────
# all｜backend｜frontend
START_MODE=all
START_PORT=8888
# 1＝dev 模式（frontend 帶 sourcemap 建置）
START_DEV=0
START_HTTPS=0
# 憑證位置；留空用 .certs/localhost-{key,cert}.pem
START_HTTPS_CERT_DIR=
START_HTTPS_KEY_PATH=
START_HTTPS_CERT_PATH=
# 0＝不在背景跑 frontend build watcher
START_FRONTEND_BUILD_WATCH=1
# 1＝略過 nvm 版本切換（改用 asdf、系統 Node 或容器映像檔內建版本時）
START_SKIP_NVM=0
# 0＝關掉 set -euo pipefail。只有在這台機器 source 進來的腳本（某些 nvm/conda 版本）與 set -u
# 相衝時才需要；平常保持 1，錯誤才不會被吞掉。
START_STRICT=1

# 測試用帳號的 AI 設定範本。
#
# 用法：
#   cp -r accounts.example/test accounts/test
#   # 填入真的 key，然後在 .env 設 TEST_AI_ACCOUNT_ID=test
#
# `accounts/` 整個在 .gitignore 裡，所以填了 key 的那一份不會進版控；這個範本刻意留空。
# 只需要填「測試真的會用到」的那個 provider——LLM 與 TTS 可以是不同家。
# 完整可用的鍵見 backend/src/services/aiSettings.ts 的 PER_ACCOUNT_ENV_PAIRS。

# ── LLM ───────────────────────────────────────────────────────────────────────
# openai | gemini | cgu-air | openrouter
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
# 其他家（用到才填）
GEMINI_API_KEY=
GEMINI_LLM_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=

# ── TTS ───────────────────────────────────────────────────────────────────────
# openai | gemini | openrouter | audiocpp（audiocpp 跑在本機、不需要 key）
TTS_PROVIDER=openai
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_SPEAKER1_VOICE=alloy
OPENAI_TTS_SPEAKER2_VOICE=nova

# ── 建議 ───────────────────────────────────────────────────────────────────────
# 給測試帳號設一個小額的月預算上限，跑壞的測試就不會把帳單燒光。
MONTHLY_BUDGET_USD=1
